# 服务端环境变量
# 用法：cp .env.example .env 后填写真实值；生产环境务必 chmod 600 .env

# ---------- 服务端口 ----------
PORT=8080

# ---------- JWT 密钥 ----------
# ⚠️ 必须用强随机值生成：openssl rand -base64 32
# ⚠️ 旧 Vercel 环境变量里的 JWT_SECRET 视为**已泄露**，迁移到腾讯云时必须换新
JWT_SECRET=your-super-secret-jwt-key-change-me

# ---------- 跨域白名单（逗号分隔）----------
# 生产同域部署时不触发 CORS，但仍建议填真实域名以便将来分域 / IP 直连调试
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库 ----------
# 方式一：完整连接字符串（腾讯云本机 Docker PG 示例，注意**不带 sslmode**）
# DATABASE_URL=postgresql://blog:你的密码@127.0.0.1:5432/blog
DATABASE_URL=

# 方式二：分项配置（DATABASE_URL 为空时生效）
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog

# 数据库连接是否走 SSL。
# ⚠️ 显式开关，不再靠「有没有 DATABASE_URL」推断：
#    - 腾讯云本机 Docker PG（默认不开 SSL）→ false
#    - 云数据库 / Supabase / Neon 等远程托管  → true
# 留空则回退到旧行为（有 DATABASE_URL 就启用 SSL）
DB_SSL=false

# 连接池最大连接数。常驻 Node 进程默认 10；
# 不要再按 serverless 思维设成 1，那会让所有查询串行走一条连接。
# DB_POOL_MAX=10

# ---------- 初始化管理员（仅 npm run db:setup 首次执行时生效）----------
# 建议用密码管理器生成强密码。两个都不填时，脚本会生成随机密码并**只在终端打印一次**。
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
